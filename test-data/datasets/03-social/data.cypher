// ---------------------------------------------------------------------------
// Dataset 03 - Social network
// ---------------------------------------------------------------------------
// Style : data driven. Nodes come from UNWIND range(...) and UNWIND over a
//         list of maps; every edge set is generated by deterministic modular
//         arithmetic over the node ids, so the whole graph is reproducible
//         and every count is derivable on paper.
// Scope  : 188 nodes / 570 relationships
//   User 60 (userId 0..59), Post 120 (postId 0..119), Tag 8 (tagIndex 0..7)
//   FOLLOWS 120, POSTED 120, TAGGED 150, LIKES 180
//
// Generation rules
//   FOLLOWS : user u follows (7u+3) % 60 and (13u+11) % 60
//             -> never a self loop and never the same target twice
//   POSTED  : post p is authored by user p % 60          -> 2 posts per user
//   TAGGED  : post p carries tag p % 8, and posts with p % 4 = 0 carry the
//             extra tag (3p+1) % 8                       -> 120 + 30 edges
//   LIKES   : user u likes posts (11u + 17k) % 120 for k in 0..2
// ---------------------------------------------------------------------------

// -- users (60) --------------------------------------------------------------
UNWIND range(0, 59) AS uid
CREATE (:User {
  userId:      uid,
  handle:      'user' + toString(uid),
  displayName: 'Member ' + toString(uid),
  joinedYear:  2018 + (uid % 6),
  reputation:  100 + ((uid * 37) % 900),
  verified:    (uid % 10) = 0
});

// -- posts (120) -------------------------------------------------------------
UNWIND range(0, 119) AS pid
CREATE (:Post {
  postId:   pid,
  title:    'Post ' + toString(pid),
  words:    120 + ((pid * 7) % 400),
  language: CASE WHEN (pid % 3) = 0 THEN 'en' WHEN (pid % 3) = 1 THEN 'de' ELSE 'fr' END,
  pinned:   (pid % 25) = 0
});

// -- tags (8) ----------------------------------------------------------------
UNWIND [
  {idx: 0, name: 'graphs',      topic: 'tech'},
  {idx: 1, name: 'cypher',      topic: 'tech'},
  {idx: 2, name: 'databases',   topic: 'tech'},
  {idx: 3, name: 'travel',      topic: 'life'},
  {idx: 4, name: 'food',        topic: 'life'},
  {idx: 5, name: 'music',       topic: 'culture'},
  {idx: 6, name: 'sports',      topic: 'culture'},
  {idx: 7, name: 'photography', topic: 'culture'}
] AS tag
CREATE (:Tag {tagIndex: tag.idx, name: tag.name, topic: tag.topic});

// -- FOLLOWS (120) -----------------------------------------------------------
MATCH (a:User)
UNWIND [((a.userId * 7) + 3) % 60, ((a.userId * 13) + 11) % 60] AS targetId
MATCH (b:User {userId: targetId})
CREATE (a)-[:FOLLOWS {since: 2019 + ((a.userId + targetId) % 5)}]->(b);

// -- POSTED (120) ------------------------------------------------------------
MATCH (p:Post)
MATCH (u:User {userId: p.postId % 60})
CREATE (u)-[:POSTED {createdOn: '2024-' + toString(1 + (p.postId % 12)) + '-15'}]->(p);

// -- TAGGED (120 primary) ----------------------------------------------------
MATCH (p:Post)
MATCH (t:Tag {tagIndex: p.postId % 8})
CREATE (p)-[:TAGGED {primary: true}]->(t);

// -- TAGGED (30 secondary, only every 4th post) ------------------------------
MATCH (p:Post)
WHERE (p.postId % 4) = 0
MATCH (t:Tag {tagIndex: ((p.postId * 3) + 1) % 8})
CREATE (p)-[:TAGGED {primary: false}]->(t);

// -- LIKES (180) -------------------------------------------------------------
MATCH (u:User)
UNWIND range(0, 2) AS k
MATCH (p:Post {postId: ((u.userId * 11) + (k * 17)) % 120})
CREATE (u)-[:LIKES {rating: 1 + ((u.userId + k) % 5)}]->(p);
