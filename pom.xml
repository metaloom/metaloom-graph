<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.metaloom.graph</groupId>
    <artifactId>graph-storage-ffm-poc</artifactId>
    <version>0.0.1-SNAPSHOT</version>

    <parent>
        <groupId>io.metaloom</groupId>
        <artifactId>maven-parent</artifactId>
        <version>2.1.0</version>
    </parent>

    <name>Graph Core</name>
    <url>https://github.com/metaloom/graph-storage-ffm-poc</url>
    <description>A java implementation for a graph storage</description>
    <inceptionYear>2024</inceptionYear>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.github.repository>jotschi/graph-storage-ffm-poc</project.github.repository>
        <!-- Tags excluded from the default surefire run. See spec/TESTING.md -->
        <excluded.test.groups>slow,bench,crash,fuzz</excluded.test.groups>
    </properties>

    <dependencies>

        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>commons-io</groupId>
            <artifactId>commons-io</artifactId>
            <version>2.18.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>25</release>
                </configuration>
            </plugin>
            <!--
                Builds the Rust native layer when cargo is present, and skips with a message when it is not.
                A missing Rust toolchain must never make the project unbuildable for a Java-only contributor:
                every native capability has a pure-Java fallback. See spec/NATIVE_FFM.md section 5.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>build-native</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>sh</executable>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <arguments>
                                <argument>-c</argument>
                                <argument>if command -v cargo >/dev/null 2>&amp;1; then cargo build --release --manifest-path native-rust-lib/Cargo.toml; else echo "[native] cargo not found, skipping the Rust layer (pure-Java fallback in use)"; fi</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${excluded.test.groups}</excludedGroups>
                    <!--
                        Surefire's default patterns cover *Test and Test* only, so a class called *Benchmark was
                        silently never run and `mvn test -Pbench` quietly did nothing. The tag, not the file name,
                        is what decides whether a class runs in a given profile.
                    -->
                    <includes>
                        <include>**/Test*.java</include>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*TestCase.java</include>
                        <include>**/*Benchmark.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- mvn test -Pslow / -Pbench / -Pcrash : see spec/TESTING.md -->
        <profile>
            <id>slow</id>
            <properties>
                <excluded.test.groups>bench,crash,fuzz</excluded.test.groups>
            </properties>
        </profile>
        <profile>
            <id>bench</id>
            <properties>
                <excluded.test.groups>slow,crash,fuzz</excluded.test.groups>
            </properties>
        </profile>
        <profile>
            <id>crash</id>
            <properties>
                <excluded.test.groups>slow,bench,fuzz</excluded.test.groups>
            </properties>
        </profile>
        <profile>
            <id>all-tests</id>
            <properties>
                <excluded.test.groups></excluded.test.groups>
            </properties>
        </profile>
    </profiles>

</project>
