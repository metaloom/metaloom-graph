<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.metaloom.graph</groupId>
    <artifactId>graph-storage-ffm-poc</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <parent>
        <groupId>io.metaloom</groupId>
        <artifactId>maven-parent</artifactId>
        <version>2.1.0</version>
    </parent>

    <name>Graph Storage</name>
    <url>https://github.com/metaloom/graph-storage-ffm-poc</url>
    <description>A java implementation for a graph storage</description>
    <inceptionYear>2024</inceptionYear>

    <!--
        Restated rather than inherited from io.metaloom:maven-parent, which declares the same licence. The parent
        resolves from a repository a reader of this checkout may not have, and a project whose licence can only be
        discovered by resolving a parent is one whose licence is not discoverable. The wording matches the parent's
        exactly so the two can never be read as different licences. See LICENSE and NOTICE at the root.
    -->
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://spdx.org/licenses/Apache-2.0.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <!--
        The storage engine and the query language are separate modules on purpose. spec/ARCHITECTURE.md states that
        a query language is not a goal *of the storage layer*, and this is what keeps that literally true: graph-cypher
        depends on graph-core's public api package and on nothing inside it. It also means the query language is a real
        consumer of that API, which is a better test of the API than any test could be.

        The same rule, one layer out: graph-protocol and graph-client depend on NEITHER of them. A client jar has no
        business carrying a storage engine it will never open or a query engine it will never run, and there is a test
        in graph-client that fails if either ever appears on its classpath. That is what keeps the client small and
        free of FFM. See spec/WIRE.md.
    -->
    <modules>
        <module>graph-core</module>
        <module>graph-cypher</module>
        <module>graph-protocol</module>
        <module>graph-client</module>
        <module>graph-server</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.github.repository>jotschi/graph-storage-ffm-poc</project.github.repository>
        <!-- Tags excluded from the default surefire run. See spec/TESTING.md -->
        <excluded.test.groups>slow,bench,crash,fuzz,huge</excluded.test.groups>
        <vertx.version>5.0.11</vertx.version>

        <!--
            The native layer. These live here rather than in graph-core so that `mvn -D...` is discoverable from the
            root, which is where the build is driven from.

            `native.skip` forces the Rust layer off even where cargo is present. The build already skips it
            automatically when cargo is absent — every native capability has a pure-Java fallback, see
            spec/NATIVE_FFM.md section 5 — so this is for the other case: proving the fallback path works, or cutting
            build time when the crate has not changed.
        -->
        <native.skip>false</native.skip>
        <!-- Follows native.skip unless the skip-native-tests profile below overrides it. -->
        <native.test.skip>${native.skip}</native.test.skip>
        <!--
            Whether the tests may *load* the native layer. Named after the system property the engine itself reads, so
            that the documented `-Dmetaloom.graph.native.enabled=false` still works: a command line -D outranks a pom
            property. Turned off along with native.skip by the profile below.
        -->
        <metaloom.graph.native.enabled>true</metaloom.graph.native.enabled>
        <!-- Set to cargo's offline flag by -Poffline, for a machine with a warm registry and no network. -->
        <cargo.offline.flag></cargo.offline.flag>

        <!--
            The browser UI, on the same terms as the native layer: `ui.skip` forces it off where npm is present, and
            the build skips it by itself where npm is absent. Without it the server still runs and still answers every
            API route; only the page is missing, and it says so. See graph-server/pom.xml.
        -->
        <ui.skip>false</ui.skip>
        <ui.test.skip>${ui.skip}</ui.test.skip>
        <npm.offline.flag></npm.offline.flag>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.metaloom.graph</groupId>
                <artifactId>graph-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.metaloom.graph</groupId>
                <artifactId>graph-core</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>io.metaloom.graph</groupId>
                <artifactId>graph-cypher</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.metaloom.graph</groupId>
                <artifactId>graph-protocol</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.metaloom.graph</groupId>
                <artifactId>graph-client</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vertx</groupId>
                <artifactId>vertx-core</artifactId>
                <version>${vertx.version}</version>
            </dependency>
            <dependency>
                <groupId>io.vertx</groupId>
                <artifactId>vertx-web</artifactId>
                <version>${vertx.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-params</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <release>25</release>
                </configuration>
            </plugin>
            <!--
                Inherited by every module, so that `mvn test -Pcrash` and friends select the same tags everywhere
                rather than only in the module that happened to declare the configuration.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <excludedGroups>${excluded.test.groups}</excludedGroups>
                    <!--
                        A hung test JVM must become a failure, not a stalled build.

                        Without this a test that parks forever - and the ones most able to do that are the ones that
                        block on a socket - takes the whole reactor with it, silently, with no report and no output.
                        That is exactly what a missing `volatile` on GraphClient.readsPaused did: the build sat for
                        twenty-five minutes with no indication of which class was stuck, and the only way to find out
                        was to attach a thread dump to the fork by hand.

                        The number is deliberately generous. The whole graph-core suite is about a minute and
                        graph-server a couple, so twenty minutes accuses nothing that is merely slow on a loaded
                        machine; it exists to convert "forever" into "red", not to police duration. `mvn test -Pslow`
                        and the soak run under their own profiles and override it where they need to.
                    -->
                    <forkedProcessTimeoutInSeconds>1200</forkedProcessTimeoutInSeconds>
                    <!--
                        And a bounded wait for a fork that has been told to exit and has not. A non-daemon thread left
                        behind by a leaked event loop or an unclosed pool keeps the JVM alive after the last test has
                        run, which stalls the build in a place no test report can explain.
                    -->
                    <forkedProcessExitTimeoutInSeconds>60</forkedProcessExitTimeoutInSeconds>
                    <!--
                        Surefire's default patterns cover *Test and Test* only, so a class called *Benchmark was
                        silently never run and `mvn test -Pbench` quietly did nothing. The tag, not the file name,
                        is what decides whether a class runs in a given profile.
                    -->
                    <includes>
                        <include>**/Test*.java</include>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*TestCase.java</include>
                        <include>**/*Benchmark.java</include>
                    </includes>
                    <systemPropertyVariables>
                        <!--
                            Not building the native layer has to mean not using it. The engine looks for the shared
                            object relative to the working directory before it looks on the classpath, so a crate
                            built earlier is still found and loaded under -Dnative.skip=true — and the run that was
                            meant to prove the pure-Java fallback quietly exercised the native path instead.
                            NativeBindingsTest caught it, by failing on a library that was loaded but not packaged.
                        -->
                        <metaloom.graph.native.enabled>${metaloom.graph.native.enabled}</metaloom.graph.native.enabled>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            `mvn -DskipTests` should skip the Rust tests too, not just the Java ones. Activating on the property's
            presence is the only way to see a bare `-DskipTests`, which sets it to the empty string rather than to
            "true" and so cannot be read as a boolean.
        -->
        <profile>
            <id>skip-native-tests</id>
            <activation>
                <property>
                    <name>skipTests</name>
                </property>
            </activation>
            <properties>
                <native.test.skip>true</native.test.skip>
                <ui.test.skip>true</ui.test.skip>
            </properties>
        </profile>
        <!--
            -Dnative.skip=true means the whole pure-Java path: not built, not packaged, and not loaded. Without the
            last of those the flag proves nothing on a machine that has ever built the crate.
        -->
        <profile>
            <id>no-native-at-runtime</id>
            <activation>
                <property>
                    <name>native.skip</name>
                    <value>true</value>
                </property>
            </activation>
            <properties>
                <metaloom.graph.native.enabled>false</metaloom.graph.native.enabled>
            </properties>
        </profile>
        <!-- A warm cargo and npm cache with no network: mvn -o -Poffline install -->
        <profile>
            <id>offline</id>
            <properties>
                <cargo.offline.flag>--offline</cargo.offline.flag>
                <npm.offline.flag>--offline</npm.offline.flag>
            </properties>
        </profile>

        <!-- mvn test -Pslow / -Pbench / -Pcrash : see spec/TESTING.md -->
        <profile>
            <id>slow</id>
            <properties>
                <excluded.test.groups>bench,crash,fuzz,huge</excluded.test.groups>
            </properties>
        </profile>
        <profile>
            <id>bench</id>
            <properties>
                <excluded.test.groups>slow,crash,fuzz,huge</excluded.test.groups>
            </properties>
        </profile>
        <profile>
            <id>crash</id>
            <properties>
                <excluded.test.groups>slow,bench,fuzz,huge</excluded.test.groups>
            </properties>
        </profile>
        <!--
            `huge` is excluded from all-tests as well, on purpose: GraphScaleBenchmark builds a store measured in
            tens of gigabytes and takes minutes. It is opt-in only, never part of "run everything".
        -->
        <profile>
            <id>all-tests</id>
            <properties>
                <excluded.test.groups>huge</excluded.test.groups>
            </properties>
        </profile>
        <profile>
            <id>huge</id>
            <properties>
                <excluded.test.groups>slow,bench,crash,fuzz</excluded.test.groups>
            </properties>
        </profile>
    </profiles>

</project>
