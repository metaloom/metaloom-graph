<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <artifactId>graph-server</artifactId>

    <parent>
        <groupId>io.metaloom.graph</groupId>
        <artifactId>metaloom-graph</artifactId>
        <version>0.1.0-alpha.1</version>
    </parent>

    <name>MetaLoom // Graph :: Server</name>
    <description>A Vert.x HTTP server exposing Cypher queries, with a React and D3 browser UI built into the jar</description>

    <properties>
        <!--
            A property rather than a literal in the plugin block below, because plugin configuration wins over a
            command line -D and would make `-Dexec.mainClass=...` silently start the wrong class. tools/demo-server.sh
            depends on being able to override it.
        -->
        <exec.mainClass>io.metaloom.graph.server.GraphServer</exec.mainClass>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.metaloom.graph</groupId>
            <artifactId>graph-cypher</artifactId>
        </dependency>
        <!--
            The dump format, so that a backup taken over HTTP is byte-for-byte the one the CLI writes offline. The
            alternative — a second encoder on the server side — is two implementations of one format, which is the
            shape that drifts.
        -->
        <dependency>
            <groupId>io.metaloom.graph</groupId>
            <artifactId>graph-cli</artifactId>
        </dependency>
        <dependency>
            <groupId>io.metaloom.graph</groupId>
            <artifactId>graph-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.metaloom.graph</groupId>
            <artifactId>graph-protocol</artifactId>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-core</artifactId>
        </dependency>
        <!--
            The client, for tests only. The wire tests are worth far more when they go through the real client than
            through a hand-rolled reader written to agree with the server: two halves written from one description by
            one person agree with each other, including where both are wrong. Test scope, so nothing of it reaches
            the shaded jar or the native image.
        -->
        <dependency>
            <groupId>io.metaloom.graph</groupId>
            <artifactId>graph-client</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-web</artifactId>
        </dependency>
        <!--
            Monitoring. Micrometer rather than the Prometheus client directly, because vertx-micrometer-metrics is
            what instruments the event loops and the HTTP servers, and it wants a Micrometer registry — using the
            Prometheus client as well would mean two registries and two scrape endpoints that disagree.

            These stop at graph-server on purpose. graph-core's only runtime dependency is slf4j and its job here is
            to *expose* records — StoreMetrics, StoreStats, IoStats, SnapshotStats — which it already does. An engine
            that a caller can embed without also taking a metrics framework is worth more than one that reports its
            own numbers. See spec/METRICS.md section 2.
        -->
        <dependency>
            <groupId>io.vertx</groupId>
            <artifactId>vertx-micrometer-metrics</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!--
            The one runtime dependency this module adds over the library modules. `java -jar` has to log somewhere:
            without a binding, slf4j discards everything and a failure to open the store is silent. The library modules
            keep logback test-scoped, as a library should — this is the executable, so it chooses.
        -->
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.metaloom.graph</groupId>
            <artifactId>graph-core</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!--
            Version-free file names under target/, so scripts, the Containerfile and the documentation never name a
            version: target/graph-server.jar is the shaded server whatever the POM says. The artifacts installed or
            deployed to a repository keep their standard versioned names; this only changes the build directory.
        -->
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <!--
                So that running the UI is one short command rather than one long one:

                    mvn -pl graph-server exec:java -Dexec.args="/path/to/store 8080"

                The main class is a property of this module, not something a caller should have to know and retype.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <configuration>
                    <mainClass>${exec.mainClass}</mainClass>
                </configuration>
                <executions>
                    <!--
                        The browser UI is a React application under src/main/frontend, bundled by Vite straight into
                        target/classes/webroot — which is what StaticHandler serves and what ends up inside the jar. No
                        copy step, and no way for `mvn package` to ship a stale bundle.

                        npm is treated exactly as cargo is: absent means skipped, with a message, never a broken build.
                        A missing Node toolchain costs the browser UI, not the server — the API still runs and says so
                        on the index page. `-Dui.skip=true` forces the same path where npm is present.

                        node_modules is NOT removed by `mvn clean`, deliberately. It is this module's dependency
                        directory, the equivalent of ~/.m2, not build output; clean does not empty the local repository
                        either. Everything the build generates is under target/ and does go.
                    -->
                    <execution>
                        <id>ui-install</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${ui.skip}</skip>
                            <executable>sh</executable>
                            <workingDirectory>${project.basedir}/src/main/frontend</workingDirectory>
                            <arguments>
                                <argument>-c</argument>
                                <argument>if command -v npm >/dev/null 2>&amp;1; then npm install --no-audit --no-fund ${npm.offline.flag}; else echo "[ui] npm not found, skipping the browser UI (the API is unaffected)"; fi</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!--
                        process-classes, after the resource copy: the bundle lands in the same directory Maven has just
                        finished writing to, and Vite empties it first.
                    -->
                    <execution>
                        <id>ui-build</id>
                        <phase>process-classes</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${ui.skip}</skip>
                            <executable>sh</executable>
                            <workingDirectory>${project.basedir}/src/main/frontend</workingDirectory>
                            <arguments>
                                <argument>-c</argument>
                                <argument>if command -v npm >/dev/null 2>&amp;1; then npm run build; else echo "[ui] npm not found, no bundle in this jar"; fi</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <!--
                        The UI's own tests, in `mvn test` alongside the Java ones. What they cover is the merge rule —
                        which node objects survive a second query — and that is logic, not appearance, so it belongs in
                        the same suite as everything else rather than in a separate ritual nobody runs.
                    -->
                    <execution>
                        <id>ui-test</id>
                        <phase>test</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${ui.test.skip}</skip>
                            <executable>sh</executable>
                            <workingDirectory>${project.basedir}/src/main/frontend</workingDirectory>
                            <arguments>
                                <argument>-c</argument>
                                <argument>if command -v npm >/dev/null 2>&amp;1; then npm test; else echo "[ui] npm not found, skipping the UI tests"; fi</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                One runnable jar: server, engine, query language, Vert.x, Netty and the UI bundle.

                    java -jar graph-server/target/graph-server.jar /path/to/store 8080

                Three details are load-bearing:

                * ServicesResourceTransformer. Vert.x and Netty find their implementations through META-INF/services,
                  and a dozen jars contribute files with the same names. Concatenating them is the difference between a
                  server that starts and one that fails on an unresolvable service.
                * module-info.class is dropped. graph-core is a named module so that native access can be granted to it
                  alone (see its module-info), but an uber jar is one classpath artifact and cannot carry several module
                  descriptors. The scoped grant is the price of the single-file distribution.
                * Enable-Native-Access: ALL-UNNAMED, which restores what that costs. Without it every FFM call from the
                  shaded jar prints a restricted-method warning on JDK 24 and later, and a future release turns those
                  into errors. Run the reactor jars instead of the shaded one to keep the narrow grant.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <!-- Signatures cover the original jars and are invalid once merged. -->
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>io.metaloom.graph.server.GraphServer</mainClass>
                                    <manifestEntries>
                                        <Enable-Native-Access>ALL-UNNAMED</Enable-Native-Access>
                                        <!-- Read back at runtime, e.g. by the MCP initialize answer; without it a release reports "dev". -->
                                        <Implementation-Title>${project.artifactId}</Implementation-Title>
                                        <Implementation-Version>${project.version}</Implementation-Version>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheLicenseResourceTransformer" />
                                <!--
                                    Merges the NOTICE of every Apache-2.0 dependency the uber jar swallows — Vert.x,
                                    Netty, SLF4J — into one. Section 4(d) of that licence requires carrying them, and
                                    without this transformer the shade plugin keeps whichever it happened to unpack
                                    last and silently drops the rest.
                                -->
                                <!--
                                    The licence text itself. It has to be injected here rather than copied into
                                    src/main/resources, because ApacheLicenseResourceTransformer above strips every
                                    META-INF/LICENSE it sees — including this module's own, which is the obvious way
                                    to do it and silently does not work. That transformer exists to collapse the
                                    dozen identical copies the dependencies bring, and it assumes the build supplies
                                    its own separately. Section 4(a) of the licence is what requires one to be there.
                                -->
                                <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                                    <file>${project.basedir}/../LICENSE</file>
                                    <resource>META-INF/LICENSE</resource>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ApacheNoticeResourceTransformer">
                                    <projectName>MetaLoom // Graph</projectName>
                                    <organizationName>MetaLoom</organizationName>
                                    <organizationURL>https://github.com/metaloom/metaloom-graph</organizationURL>
                                    <inceptionYear>2024</inceptionYear>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            The GraalVM native build: `mvn -Pgraalvm package`, producing target/native/graph-server.

            Opt-in, because it needs a GraalVM installation that the ordinary build does not, and because
            it takes about forty seconds on top of everything else. Off, nothing in this profile is read:
            no svm dependency is resolved, and src/nativeimage/java is not a source root.

            Almost everything that makes the image buildable travels inside the jar rather than living here:
            the FFM downcall registrations and the shared-arena flag in graph-core, the reflection and
            resource metadata in this module, both under META-INF/native-image. The exception is the netty
            substitution in src/nativeimage/java, which is source and has to be compiled — so a jar built
            *with* this profile is native-image ready and one built without it is not. That is the only
            difference between the two jars, and it is why `native-image -jar` on a plain `mvn package` jar
            still fails at netty's CleanerJava24Linker. See spec/GRAALVM.md section 5.
        -->
        <profile>
            <id>graalvm</id>
            <properties>
                <!-- Must match the GraalVM that runs the build; the substitution API is not versioned across releases. -->
                <graalvm.version>25.0.3</graalvm.version>
            </properties>
            <dependencies>
                <!--
                    Compile-only, and only inside this profile. `provided` keeps it out of the shaded jar and
                    off the test classpath; native-image supplies these classes itself when it reads the image.
                -->
                <dependency>
                    <groupId>org.graalvm.nativeimage</groupId>
                    <artifactId>svm</artifactId>
                    <version>${graalvm.version}</version>
                    <scope>provided</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>build-helper-maven-plugin</artifactId>
                        <version>3.6.0</version>
                        <executions>
                            <execution>
                                <id>native-image-sources</id>
                                <phase>generate-sources</phase>
                                <goals>
                                    <goal>add-source</goal>
                                </goals>
                                <configuration>
                                    <sources>
                                        <source>${project.basedir}/src/nativeimage/java</source>
                                    </sources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!--
                        verify, not package: the shade plugin has to have finished writing the jar this reads,
                        and two executions of two different plugins in the same phase order by declaration in a
                        way that is easy to get wrong and hard to notice.
                    -->
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>native-image</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>exec</goal>
                                </goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>${project.basedir}/../tools/native-image.sh</argument>
                                        <argument>${project.build.directory}/${project.build.finalName}.jar</argument>
                                        <argument>${project.build.directory}/native</argument>
                                        <argument>graph-server</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
